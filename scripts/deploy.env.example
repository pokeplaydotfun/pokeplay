# Local deploy config for scripts/deploy.sh. Copy this file to
#   scripts/deploy.env
# and fill in your own values. deploy.env is gitignored and never published.

# The deploy target, as an ssh destination.
HOST=user@your.server

# Space-separated list of other live sites on the same host that must keep
# working — health-checked before and after each deploy. Leave empty if none.
NEIGHBOURS="https://example.com https://another.example"
