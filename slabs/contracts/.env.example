# Copy to .env and fill in. NEVER commit .env (doc 00 §9).
#
# These are PWA's OWN contracts. Do not paste addresses or keys from any other
# deployment: the whole point of this project being separate is that a
# compromise or a bug on one cannot reach the other.

# --- RPC ---
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_TESTNET_RPC_URL=

# --- Keys ---
# Deploys, then hands ownership to OWNER_ADDRESS. Can be a throwaway, and
# preferably is: it only needs enough gas for one deploy batch.
DEPLOYER_PRIVATE_KEY=

# --- Roles (doc 06 §4) ---
# SINGLE-KEY SETUP, chosen by the operator 22 Jul 2026. Set all four to the same
# public address, and use that wallet's key as DEPLOYER_PRIVATE_KEY.
#
# Recorded so the trade-off is legible rather than rediscovered: WORKER is the
# only role that lives in a server .env, so pointing the other three at it puts
# forceRefund, every setter, transferOwnership and the revenue balance behind
# that one file. Accepted deliberately.
#
# Reversible without redeploying, if that changes: sale.transferOwnership() and
# mirror.transferOwnership() split the roles on live contracts.
#
# Admin key. Holds the forceRefund escape hatch and every setter.
OWNER_ADDRESS=
# Worker hot key. The Fulfiller's caller and the unwrap quote signer; the one
# the server holds.
WORKER_ADDRESS=
# Automated health monitor. Can pause; cannot unpause.
GUARDIAN_ADDRESS=
# Revenue recipient.
TREASURY_ADDRESS=

# --- Token ---
# Robinhood Chain USDG. The deploy script verifies symbol and decimals on chain
# before wiring it into three contracts, so a wrong address fails loudly.
USDG_ADDRESS=

# --- Caps (doc 02 §7) ---
# 6 decimals (e.g. 55000000 = $55). An operational detail — kept OUT of the public
# repo; set it per deployment, above your priciest pack.
MAX_PACK_PRICE_USDG=

# --- Marketplace ---
# Secondary-sale fee in basis points. Contract caps this at 500 (5%). 250 = 2.5%.
MARKET_FEE_BPS=250
