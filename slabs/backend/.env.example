# Copy to .env and fill in. NEVER commit .env (doc 00 §9).

# Mocks are the default and the only safe mode until doc 01 T1-T3 have run.
# Setting this false with an unimplemented CC client will fail loudly, not silently.
USE_MOCKS=true

# --- Robinhood Chain ---
RH_RPC_URL=https://rh-chain-mainnet.g.alchemy.com/v2/YOUR_KEY
RH_WS_URL=
# Verified as "Global Dollar" USDG, 6dp, by two independent registries (Across, deBridge).
# Confirm against docs.robinhood.com/chain before deploying — it is an immutable ctor arg.
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
PACK_SALE_ADDRESS=
MIRROR_NFT_ADDRESS=
FULFILLER_ADDRESS=
# Worker hot key ONLY. The owner key (which holds forceRefund) must never be in this file —
# that separation is what makes the escape hatch human-only (doc 06 §4).
WORKER_PRIVATE_KEY=

# --- Collector Crypt ---
# Referral code. Sent as the `referrer` cookie on every CC call, which is the only mechanism
# CC exposes (GET /referral/<code> just sets that cookie). Attribution is NOT observable from
# our side, so confirm with CC after the first real pack open.
CC_REFERRAL_CODE=

# --- Solana ---
# Use Helius/QuickNode. The public endpoint will rate-limit the worker into failures.
SOLANA_RPC_URL=
# The wallet that buys packs and custodies every card.
SOLANA_OPERATOR_ADDRESS=CARD7cmGjygGCSkrbXdxBN8Zr9Zd1fN1mjZdvSLqHuaN
# Its secret key. This must be the key FOR the address above, not a freshly generated one.
SOLANA_OPERATOR_SECRET_KEY=
USDC_SOLANA_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# --- Bridge ---
# deBridge, NOT Across: Across has no live Solana route in either direction
# (verified 2026-07-18, docs/verification/verification-results.md T4).
BRIDGE_PROVIDER=debridge
DEBRIDGE_API_URL=https://dln.debridge.finance/v1.0
# Measured fees: ~$0.77 out, ~$0.91 back. Alert on excursion, abort before a leg can
# invert an individual trade (spread on a $50 pack is only ~$2.60).
BRIDGE_COST_ALERT_USD=2.0
BRIDGE_COST_ABORT_USD=5.0
BRIDGE_FILL_TIMEOUT_MS=180000

# --- Economics (doc 02 §7) ---
SPREAD_BPS=500
USER_WINDOW_HOURS=66
CC_WINDOW_HOURS=72
# T3 ANSWERED 2026-07-18: CC buyback eligibility follows the CARD, not the wallet — any
# holder can sell it back. The bypass is open, so the in-window fee is required, or a user
# unwraps, sells to CC at 85%, and keeps our 5pp. Free again once CC's 72h window closes.
UNWRAP_FEE_DURING_WINDOW_BPS=500
QUOTE_TTL_SEC=60
QUOTE_DRIFT_REVALIDATE_BPS=25

# Master switch for sell-back (Flow B). Default off, and it must stay off until the inbound
# bridge (Solana USDC -> RH USDG) has been proven against the real network. The sale to
# Collector Crypt happens BEFORE the bridge leg, so a half-wired sell-back would sell
# somebody's physical card and then strand the proceeds. With this off, quotes are declined
# and any mirror sent to custody is handed straight back.
SELL_BACK_ENABLED=false
# REQUIRED. The insured value above which a sell-back or withdrawal stops being automatic and
# is held for a person. Deliberately has no default in code: this repository is public, and the
# threshold is an operational detail. Set it to whatever you are willing to settle unattended.
SELL_BACK_MAX_VALUE_USD=

# --- Limits ---
ORDER_TIMEOUT_MIN=10
# The per-pack price ceiling. Like the sell-back cap above, this is an operational
# detail kept OUT of the public repo — set it per deployment, above your priciest pack.
MAX_PACK_PRICE_USDG=

# --- Branding (Slabs, inside pokeplay) ---
# The wallet-signed message namespace. MUST match the frontend's VITE_SIGNING_NS
# exactly or set/read-withdraw-address and deposit signatures will fail to verify.
SIGNING_NS=Slabs
# Public site origin, used to build NFT metadata image/external_url.
SITE_URL=https://pokeplay.fun
PUBLIC_API_URL=https://pokeplay.fun/slabs-api

# --- Local ---
DB_PATH=./data/slabs.sqlite
API_PORT=8787
# In production this is the pokeplay origin the Slabs frontend is served from.
CORS_ORIGIN=http://localhost:5180
